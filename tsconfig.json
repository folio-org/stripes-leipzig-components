{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "strict": true,
    // this skips our own declarations as well, but checking every .d.ts of every
    // dependency makes the result depend on the install topology -- see README
    "skipLibCheck": true,
    "types": []
  },
  "include": ["index.d.ts", "lib/**/*.d.ts", "test/types/**/*"]
}
